{
  "name": "@grandstand/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grandstand/game-engine": "workspace:*",
    "@grandstand/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
